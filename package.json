{
  "name": "dsh-plugin-multi-chat-windows",
  "version": "0.4.4",
  "description": "话分两头 · Stop switching between chats — open side-by-side native DSH conversations in split windows, minimize them to a live status dock (running / done / approval pending), tile with one click, and pop them out into their own browser window",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "license": "MIT",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-window",
    "chat-windows",
    "split-view",
    "plugin"
  ],
  "homepage": "https://github.com/yuna78/dsh-plugin-multi-chat-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuna78/dsh-plugin-multi-chat-windows.git"
  },
  "bugs": {
    "url": "https://github.com/yuna78/dsh-plugin-multi-chat-windows/issues"
  },
  "scripts": {
    "prepublishOnly": "node tools/check-bundle.mjs"
  }
}
